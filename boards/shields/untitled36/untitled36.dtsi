#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &untitled36_physical_layout;
    };

    untitled36_physical_layout: untitled36_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w   h    x    y    rot    rx    ry
            = <&key_physical_attrs 92 87     11    78      0    57   122>  /* C1R0   小指   R0 */
            , <&key_physical_attrs 92 87   105    34      0   151    78>  /* C2R0   薬指   R0 */
            , <&key_physical_attrs 92 87   200     11      0   246    55>  /* C3R0   中指   R0 */
            , <&key_physical_attrs 92 87   294    56      0   340   100>  /* C4R0   人差指 R0 */
            , <&key_physical_attrs 92 87   388    56      0   434   100>  /* C5R0   内側   R0 */
            , <&key_physical_attrs 92 87   672    56      0   718   100>  /* C5R0_R 内側   R0（右） */
            , <&key_physical_attrs 92 87   766    56      0   812   100>  /* C4R0_R 人差指 R0（右） */
            , <&key_physical_attrs 92 87   861     11      0   907    55>  /* C3R0_R 中指   R0（右） */
            , <&key_physical_attrs 92 87   955    34      0  1001    78>  /* C2R0_R 薬指   R0（右） */
            , <&key_physical_attrs 92 87  1050    78      0  1096   122>  /* C1R0_R 小指   R0（右） */

            , <&key_physical_attrs 92 87     11   168      0    57   212>  /* C1R1 */
            , <&key_physical_attrs 92 87   105   123      0   151   167>  /* C2R1 */
            , <&key_physical_attrs 92 87   200    101      0   246   145>  /* C3R1 */
            , <&key_physical_attrs 92 87   294   145      0   340   189>  /* C4R1 */
            , <&key_physical_attrs 92 87   388   145      0   434   189>  /* C5R1 */
            , <&key_physical_attrs 92 87   672   145      0   718   189>  /* C5R1_R */
            , <&key_physical_attrs 92 87   766   145      0   812   189>  /* C4R1_R */
            , <&key_physical_attrs 92 87   861    101      0   907   145>  /* C3R1_R */
            , <&key_physical_attrs 92 87   955   123      0  1001   167>  /* C2R1_R */
            , <&key_physical_attrs 92 87  1050   168      0  1096   212>  /* C1R1_R */

            , <&key_physical_attrs 92 87     11   257      0    57   301>  /* C1R2 */
            , <&key_physical_attrs 92 87   105   212      0   151   256>  /* C2R2 */
            , <&key_physical_attrs 92 87   200   190      0   246   234>  /* C3R2 */
            , <&key_physical_attrs 92 87   294   234      0   340   278>  /* C4R2 */
            , <&key_physical_attrs 92 87   388   234      0   434   278>  /* C5R2 */
            , <&key_physical_attrs 92 87   672   234      0   718   278>  /* C5R2_R */
            , <&key_physical_attrs 92 87   766   234      0   812   278>  /* C4R2_R */
            , <&key_physical_attrs 92 87   861   190      0   907   234>  /* C3R2_R */
            , <&key_physical_attrs 92 87   955   212      0  1001   256>  /* C2R2_R */
            , <&key_physical_attrs 92 87  1050   257      0  1096   301>  /* C1R2_R */

            , <&key_physical_attrs 92 87   237   349      0   283   393>  /* T_out   親指外側 */
            , <&key_physical_attrs 92 87   341   363   1500   387   407>  /* T_mid   親指中央 */
            , <&key_physical_attrs 92 87   438   403   3000   484   447>  /* T_in    親指内側 */
            , <&key_physical_attrs 92 87   622   403 (-3000)   668   447>  /* T_in_R  親指内側（右） */
            , <&key_physical_attrs 92 87   719   363 (-1500)   765   407>  /* T_mid_R 親指中央（右） */
            , <&key_physical_attrs 92 87   823   349      0   869   393>  /* T_out_R 親指外側（右） */
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
                            RC(3,2) RC(3,3) RC(3,4)    RC(3,9) RC(3,8) RC(3,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
        row-gpios
            = <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW0 = D1 = P0.03 */
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW1 = D2 = P0.28 */
            , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW2 = D3 = P0.29 */
            , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* ROW3 = D6 = P1.11（親指行） */
            ;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };
};

// XIAO標準のUART・SPI・I2Cは、キーとトラックボールのピンとぶつかるので止める
&xiao_serial {
    status = "disabled";
};

&spi2 {
    status = "disabled";
};

&xiao_i2c {
    status = "disabled";
};

&spi0 {
    status = "disabled";

    trackball: trackball@0 {
        status = "disabled";
        reg = <0>;
    };
};
