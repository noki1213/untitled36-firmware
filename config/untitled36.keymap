#include "zmk-helpers/helper.h"
#include "includes/untitled36.h"

// Homerow Mods の設定
#define HM_TAPPING_TERM 180

// レイヤー定義
#define BASE 0
#define SYM 1
#define NAV 2
#define WINDOW 3
#define SCROLL 4
#define SETTING 5

// キー位置の定義（Homerow Mods 用）
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // 左手
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // 右手
#define THUMBS LH1 LH0 RH0 RH1

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

// マウススクロールの挙動調整（加速なし、即反応）
&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
    delay-ms = <0>;
};

// レイヤータップのタッピングターム調整
&lt {
    tapping-term-ms = <180>;
};

/ {
    macros {
        // ・（中黒）入力: LANG1 → / → Enter
        nakaguro: nakaguro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1 &kp FSLH &kp ENTER>;
        };


        // Cmd+上スクロール（押している間続く）: ピンチイン（ズームイン）
        zoom_in: zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &msc SCRL_DOWN>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_DOWN &kp LGUI>;
        };

        // レイヤー有効化 + Ctrl/Option 押しっぱなし（押している間続く）
        // パラメータ = 有効化するレイヤー番号
        layer_ctrl_alt: layer_ctrl_alt {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_press &kp LCTRL &kp LALT>
                , <&macro_pause_for_release>
                , <&macro_release &kp LALT &kp LCTRL>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>;
        };

        // Cmd+下スクロール（押している間続く）: ピンチアウト（ズームアウト）
        zoom_out: zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI &msc SCRL_UP>
                , <&macro_pause_for_release>
                , <&macro_release &msc SCRL_UP &kp LGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // WR → TAB
        combo_tab_l {
            timeout-ms = <45>;
            key-positions = <1 3>;  // W, R
            bindings = <&kp TAB>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW では無効
        };

        // UO → TAB
        combo_tab_r {
            timeout-ms = <45>;
            key-positions = <6 8>;  // U, O
            bindings = <&kp TAB>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW では無効
        };

        // DF → 左クリック
        combo_lclick {
            timeout-ms = <45>;
            key-positions = <12 13>;  // D, F
            bindings = <&mkp LCLK>;
            layers = <BASE SYM NAV>;
        };

        // DS → 右クリック
        combo_rclick {
            timeout-ms = <45>;
            key-positions = <11 12>;  // S, D
            bindings = <&mkp RCLK>;
            layers = <BASE SYM NAV>;
        };

        // JK → 左クリック
        combo_lclick_r {
            timeout-ms = <45>;
            key-positions = <16 17>;  // J, K
            bindings = <&mkp LCLK>;
            layers = <BASE SYM NAV>;
        };

        // KL → 右クリック
        combo_rclick_r {
            timeout-ms = <45>;
            key-positions = <17 18>;  // K, L
            bindings = <&mkp RCLK>;
            layers = <BASE SYM NAV>;
        };


        // FS → F15
        combo_f15_l {
            timeout-ms = <45>;
            key-positions = <11 13>;  // S, F
            bindings = <&kp F15>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW では無効
        };

        // JL → F15
        combo_f15_r {
            timeout-ms = <45>;
            key-positions = <16 18>;  // J, L
            bindings = <&kp F15>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW では無効
        };

        // FDS → F16
        combo_f16_l {
            timeout-ms = <45>;
            key-positions = <11 12 13>;  // S, D, F
            bindings = <&kp F16>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW では無効
        };

        // JKL → F16
        combo_f16_r {
            timeout-ms = <45>;
            key-positions = <16 17 18>;  // J, K, L
            bindings = <&kp F16>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW では無効
        };

        // FA → F17
        combo_f17_l {
            timeout-ms = <45>;
            key-positions = <10 13>;  // A, F
            bindings = <&kp F17>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW では無効
        };

        // J- → F17
        combo_f17_r {
            timeout-ms = <45>;
            key-positions = <16 19>;  // J, -
            bindings = <&kp F17>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW では無効
        };

        // WE → ESC
        combo_esc_l {
            timeout-ms = <45>;
            key-positions = <1 2>;  // W, E
            bindings = <&kp ESC>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW では無効
        };

        // IO → ESC
        combo_esc_r {
            timeout-ms = <45>;
            key-positions = <7 8>;  // I, O
            bindings = <&kp ESC>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW では無効
        };

        // LANG2+LANG1 タップ → Command + Option + Space、ホールド → Setting レイヤー
        combo_setting_hold {
            timeout-ms = <45>;
            key-positions = <31 34>;  // LANG2(LH1), LANG1(RH1)
            bindings = <&lt SETTING LA(LG(SPACE))>;
            layers = <BASE SYM NAV SCROLL SETTING>;  // WINDOW では無効
        };

    };

    behaviors {
        // 左手用 Homerow Mods（Ctrl, Option, Cmd）
        hm_l: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;

            hold-trigger-key-positions = <THUMBS>;
            hold-trigger-on-release;
        };

        // 左手 Shift 専用 Homerow Mods
        hm_l_shift: homerow_mods_left_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;

            hold-trigger-key-positions = <THUMBS>;
            hold-trigger-on-release;
        };

        // 右手用 Homerow Mods（Cmd, Option, Ctrl）
        hm_r: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;

            hold-trigger-key-positions = <THUMBS>;
            hold-trigger-on-release;
        };

        // 右ホーム外側キー用（タップ: |/Shiftで_, ホールド: RALT）
        hm_r_ralt_pipe: homerow_mods_right_ralt_pipe {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&mm_pipe>;

            flavor = "tap-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;

            hold-trigger-key-positions = <THUMBS>;
            hold-trigger-on-release;
        };

        // 右ホーム外側キー用（タップ: -/Shiftで~, ホールド: Shift）
        hm_r_shift: homerow_mods_right_shift_minus {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&mm_minus>;

            flavor = "tap-preferred";
            tapping-term-ms = <HM_TAPPING_TERM>;
            quick-tap-ms = <200>;

            hold-trigger-key-positions = <THUMBS>;
            hold-trigger-on-release;
        };

        // Ctrl/Option 付きレイヤータップ（&lt の代わり）
        // タップ: 第2引数のキー / ホールド: レイヤー有効化 + Ctrl+Option 押しっぱなし
        lt_ctrl_alt: layer_tap_ctrl_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&layer_ctrl_alt>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <180>;
        };

        // Nav用 hold-tap（タップで移動、ホールドで選択）
        ht_nav: hold_tap_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <180>;
        };

        // mod-morph: ' → Shift: "
        mm_quot: mod_morph_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: # → Shift: *
        mm_hash: mod_morph_hash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp HASH>, <&kp ASTRK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: $ → Shift: %
        mm_dllr: mod_morph_dollar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DLLR>, <&kp PRCNT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: \ → Shift: `
        mm_bslh: mod_morph_backslash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSLH>, <&kp GRAVE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: < → Shift: >
        mm_lt: mod_morph_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp GT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: ( → Shift: )
        mm_lpar: mod_morph_lpar {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp RPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: [ → Shift: ]
        mm_lbkt: mod_morph_lbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp RBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: { → Shift: }
        mm_lbrc: mod_morph_lbrc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBRC>, <&kp RBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: | → Shift: _
        mm_pipe: mod_morph_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PIPE>, <&kp UNDER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: : → Shift: ;
        mm_colon: mod_morph_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: = → Shift: ~
        mm_equal: mod_morph_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: = → Shift: _
        mm_equal_under: mod_morph_equal_under {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp UNDER>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: - → Shift: ~
        mm_minus: mod_morph_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: ? → Shift: !
        mm_question: mod_morph_question {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(FSLH)>, <&kp LS(N1)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: + → Shift: ^
        mm_plus: mod_morph_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp CARET>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: Backspace → Shift: Delete
        mm_bspc: mod_morph_bspc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: Cmd+Tab → Shift: Option+Tab (window layer)
        mm_window_tab: mod_morph_window_tab {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(TAB)>, <&kp LA(TAB)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: Cmd+- → Shift: Option+Cmd+- (ズームアウト)
        mm_short_minus: mod_morph_short_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(MINUS)>, <&kp LA(LG(MINUS))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mod-morph: Cmd++ → Shift: Option+Cmd+= (ズームイン)
        mm_short_plus: mod_morph_short_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(PLUS)>, <&kp LA(LG(EQUAL))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ショートカットレイヤー D位置: Shift時のhold-tap
        // タップ→Cmd+Shift+Opt+V、ホールド→Cmd+Ctrl+V
        ht_d_shift: hold_tap_d_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <180>;
        };

        // D位置 mod-morph: 通常→Cmd+V/Cmd+Shift+V、Shift→Cmd+Shift+Opt+V/Cmd+Ctrl+V
        mm_short_d: mod_morph_short_d {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ht_nav LG(LS(V)) LG(V)>, <&ht_d_shift LC(LG(V)) LG(LS(LA(V)))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ショートカットレイヤー F位置: Shift時のhold-tap
        // タップ→Cmd+Shift+C、ホールド→Cmd+Shift+2
        ht_f_shift: hold_tap_f_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <180>;
        };

        // F位置 mod-morph: 通常→Cmd+C/Cmd+Shift+4、Shift→Cmd+Shift+C/Cmd+Shift+2
        mm_short_f: mod_morph_short_f {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&ht_nav LG(LS(N4)) LG(C)>, <&ht_f_shift LG(LS(N2)) LG(LS(C))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // --- スクロールレイヤー用 mod-morph ---

        // E: Scroll Up (Natural: Down signal) / Shift: Top (Cmd+Up)
        mm_scrl_e: mod_morph_scroll_e {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&kp LG(UP)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // D: Scroll Down (Natural: Up signal) / Shift: Bottom (Cmd+Down)
        mm_scrl_d: mod_morph_scroll_d {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&kp LG(DOWN)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // S: Scroll Left (Natural: Right signal) / Shift: Line Start (Cmd+Left)
        mm_scrl_s: mod_morph_scroll_s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&kp LG(LEFT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // F: Scroll Right (Natural: Left signal) / Shift: Line End (Cmd+Right)
        mm_scrl_f: mod_morph_scroll_f {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&kp LG(RIGHT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // QWERTY + Homerow Mods
            // ------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |           |  Y  |  U  |  I  |  O  |  P  |
            // | A/⇧ | S/⌥ | D/⌘ | F/⌃ |  G  |           |  H  | J/⌃ | K/⌘ | L/⌥ |-/⇧ |
            // |  Z  |  X  |  C  |  V  |  B  |           |  N  |  M  |  、 |  。 | ?/! |
            //       | TK  |LANG2| SPC |           | ENT |LANG1| BKSP|

            bindings = <
&kp Q                  &kp W            &kp E            &kp R            &kp T             &kp Y      &kp U          &kp I            &kp O            &kp P
&hm_l_shift LSHFT A    &hm_l LALT S     &hm_l LGUI D     &hm_l LCTRL F    &kp G             &kp H      &hm_r RCTRL J  &hm_r RGUI K     &hm_r RALT L     &hm_r_shift RSHFT MINUS
&kp Z                  &kp X            &kp C            &kp V            &kp B             &kp N      &kp M          &kp COMMA        &kp PERIOD       &mm_question
                        &kp LS(LC(LA(LG(SPACE))))         &lt SYM LANG2    &lt SCROLL SPACE  &lt_ctrl_alt WINDOW ENTER  &lt NAV LANG1  &mm_bspc
            >;
        };

        symbol_layer {
            display-name = "Symbol";

            // 記号レイヤー
            // ------------------------------------------------------------------
            // |¥/Y | '/" | #/* | $/% | \/` |           | </>  | (/)  | [/]  | {/}  | =/_ |
            // |  5  |  4  |  3  |  2  |  1  |           |  6  |  7  |  8  |  9  | --- |
            // |  |  |  @  |  :  |  &  |  @  |           |  /  |  0  | --- | --- | +/^ |
            //       |Cmd+SPC| [L] | --- |           | --- | --- | --- |

            bindings = <
&kp LA(Y)              &mm_quot         &mm_hash         &mm_dllr         &mm_bslh          &mm_lt     &mm_lpar  &mm_lbkt       &mm_lbrc         &mm_equal_under
&hm_l_shift LSHFT N5   &hm_l LALT N4    &hm_l LGUI N3    &hm_l LCTRL N2   &kp N1            &kp N6     &hm_r RCTRL N7  &hm_r RGUI N8    &hm_r RALT N9    &hm_r_shift RSHFT MINUS
&kp PIPE                &kp AT           &mm_colon        &kp AMPS         &kp AT            &kp FSLH   &kp N0         &trans           &trans           &mm_plus
                        &trans           &trans           &kp LG(SPACE)     &trans                     &trans         &trans
            >;
        };

        nav_layer {
            display-name = "Nav";

            // カーソルレイヤー
            // ------------------------------------------------------------------
            // | --- | --- | --- | --- | --- |           | --- |Cmd↑ |  ↑  |Cmd↓ | --- |
            // | --- | --- | --- | --- | --- |           |  ←  |  ↓  |  →  | --- | --- |
            // | --- | --- | --- | --- | --- |           | --- | --- | --- | --- | --- |
            //       | --- | --- | --- |           | --- | [L] | --- |

            bindings = <
&trans    &trans           &trans           &trans           &trans            &trans     &kp LG(UP)  &kp UP       &kp LG(DOWN)     &trans
&trans    &trans           &trans           &trans           &trans            &ht_nav LG(LS(LEFT)) LG(LEFT)  &kp LEFT  &kp DOWN  &kp RIGHT  &ht_nav LG(LS(RIGHT)) LG(RIGHT)
&trans    &trans           &trans           &trans           &trans            &trans     &trans      &trans       &trans           &trans
                            &trans           &trans           &trans                       &trans     &trans      &trans
            >;
        };

        window_layer {
            display-name = "Window";

            // ウィンドウ操作レイヤー（Ctrl+Alt + 英文字）
            // ------------------------------------------------------------------
            // |C+A+Q|C+A+W|C+A+E|C+A+R|C+A+T|           |C+A+Y|C+A+U|C+A+I|C+A+O|C+A+P|
            // |C+A+A|C+A+S/⌥|C+A+D/⌘|C+A+F/⌃|C+A+G|     |C+A+H|C+A+J/⌃|C+A+K/⌘|C+A+L/⌥|C+A+-/⇧|
            // |C+A+Z|C+A+X|C+A+C|C+A+V|C+A+B|           |C+A+N|C+A+M|C+A+, |C+A+. |C+A+S+=|
            //       |無効 |無効 |無効 |           | [L] |無効 |無効 |

            bindings = <
&kp LC(LA(Q))    &kp LC(LA(W))    &kp LC(LA(E))              &kp LC(LA(R))            &kp LC(LA(T))            &kp LC(LA(Y))       &kp LC(LA(U))       &kp LC(LA(I))   &kp LC(LA(O))        &kp LC(LA(P))
&kp LC(LA(A))    &hm_l LALT LC(LA(S))    &hm_l LGUI LC(LA(D))    &hm_l LCTRL LC(LA(F))   &kp LC(LA(G))            &kp LC(LA(H))       &hm_r RCTRL LC(LA(J))    &hm_r RGUI LC(LA(K))   &hm_r RALT LC(LA(L))    &hm_r RSHFT LC(LA(MINUS))
&kp LC(LA(Z))    &kp LC(LA(X))    &kp LC(LA(C))              &kp LC(LA(V))            &kp LC(LA(B))            &kp LC(LA(N))       &kp LC(LA(M))       &kp LC(LA(COMMA)) &kp LC(LA(PERIOD))   &kp LC(LA(LS(EQUAL)))
                  &none            &none                      &none                    &trans                   &none               &none
            >;
        };

        scroll_layer {
            display-name = "Scroll";

            // スクロールレイヤー
            // ------------------------------------------------------------------
            // | --- | --- |  E↑ | --- | --- |           | --- |Iズーム+| --- | --- |
            // | --- | S←  |  D↓ | F→  | --- |           | --- |Kズーム-| --- | --- |
            // | --- | --- | --- | --- | --- |           | --- | --- | --- | --- |
            //       | --- | [L] | --- |           | --- | --- | --- |

            bindings = <
&trans    &trans           &mm_scrl_e       &trans           &trans            &trans     &trans  &zoom_in     &trans           &trans
&trans    &mm_scrl_s       &mm_scrl_d       &mm_scrl_f       &trans            &trans     &trans  &zoom_out    &trans           &trans
&trans    &trans           &trans           &trans           &trans            &trans     &trans  &trans       &trans           &trans
                            &trans           &trans           &trans                      &trans     &trans  &trans
            >;
        };

        setting_layer {
            display-name = "Setting";

            // 設定レイヤー（LANG2+LANG1 同時押しでトグル）
            // ------------------------------------------------------------------
            // | OFF | --- | --- | --- | --- |           | --- | --- | BT.2| --- | BT.1|
            // | --- | --- | --- | --- | --- |           | --- | --- | --- | --- | --- |
            // | --- | --- | --- | --- | BT.R|           | --- | BT.0| --- | --- | --- |
            //       | --- | --- | --- |           | --- | --- | --- |

            bindings = <
&soft_off &trans           &trans           &trans           &trans            &trans     &trans  &bt BT_SEL 2 &trans           &bt BT_SEL 1
&trans    &trans           &trans           &trans           &trans            &trans     &trans  &trans       &trans           &trans
&trans    &trans           &trans           &trans           &bt BT_CLR        &trans     &bt BT_SEL 0  &trans       &trans           &trans
                            &trans           &trans           &trans                      &trans     &trans  &trans
            >;
        };
    };
};
